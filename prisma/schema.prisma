generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MEMBER
  ADMIN
}

enum StoreCategory {
  MAHJONG
  BOARDGAME
}

enum TableType {
  MAHJONG
  BOARDGAME
}

enum BookingType {
  MAHJONG
  BOARDGAME
  BIRTHDAY_PARTY
  EVENT_GATHERING
}

enum BookingStatus {
  AWAITING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum BookingSource {
  ONLINE
  WALK_IN
  ADMIN
}

enum OpenTableSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String?            @unique
  phone                  String?            @unique
  passwordHash           String?
  role                   UserRole           @default(USER)
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  bookings               Booking[]
  verifiedPaymentProofs  PaymentProof[]     @relation("VerifiedByUser")
  bookingStatusLogs      BookingStatusLog[] @relation("ChangedByUser")
}

model Store {
  id                      String        @id @default(cuid())
  name                    String
  slug                    String        @unique
  category                StoreCategory @default(MAHJONG)
  address                 String?
  city                    String?
  description             String?
  openHour                Int           @default(11)
  closeHour               Int           @default(22)
  isActive                Boolean       @default(true)
  coverImageUrl           String?
  coverImagePublicId      String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  openTableSessions       OpenTableSession[]
  locationHint            String?

  tables       Table[]
  bookings     Booking[]
  bookingSlots BookingSlot[]
}

model Table {
  id                      String        @id @default(cuid())
  storeId                 String
  tableNumber             Int
  tableCode               String?
  tableType               TableType     @default(MAHJONG)
  capacity                Int?
  positionX               Int?
  positionY               Int?
  isActive                Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  openTableSessions       OpenTableSession[]
  displayLabel            String?
  note                    String?

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  bookingSlots BookingSlot[]

  @@unique([storeId, tableNumber])
}

model Booking {
  id               String            @id @default(cuid())
  bookingCode      String            @unique
  userId           String?
  storeId          String
  tableId          String
  bookingType      BookingType       @default(MAHJONG)
  status           BookingStatus     @default(AWAITING_PAYMENT)
  source           BookingSource     @default(ONLINE)

  customerName     String
  customerPhone    String?
  customerEmail    String?

  bookingDate      DateTime
  startHour        Int
  endHour          Int
  totalSlots       Int
  pricePerHour     Int
  totalPrice       Int

  expiresAt        DateTime?
  notes            String?
  createdByAdmin   Boolean           @default(false)
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  graceMinutesUsed Int               @default(0)

  paymentGatewayToken       String?

  paymentReferenceId        String?   @unique
  paymentGatewayProvider    String?
  paymentGatewayStatus      String?
  paymentMethodCode         String?
  paymentCheckoutUrl        String?
  paymentGatewayPayload     Json?
  paymentRequestedAt        DateTime?
  paymentSucceededAt        DateTime?
  paymentExpiredAt          DateTime?
  paymentActionType         String?
  paymentActionDescriptor   String?
  paymentActionValue        String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table            Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  slots            BookingSlot[]
  paymentProofs    PaymentProof[]
  statusLogs       BookingStatusLog[]

  @@index([storeId, bookingDate])
  @@index([tableId, bookingDate])
  @@index([status])
}

model BookingSlot {
  id           String        @id @default(cuid())
  bookingId    String
  storeId      String
  tableId      String
  bookingDate  DateTime
  slotHour     Int
  slotEndHour  Int
  status       BookingStatus @default(AWAITING_PAYMENT)
  createdAt    DateTime      @default(now())

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table        Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([storeId, bookingDate])
  @@index([tableId, bookingDate, slotHour])
}

model PaymentProof {
  id                 String             @id @default(cuid())
  bookingId          String
  fileUrl            String
  fileName           String?
  fileSize           Int?
  mimeType           String?
  uploadedAt         DateTime           @default(now())
  verificationStatus PaymentProofStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedAt         DateTime?
  rejectionReason    String?

  booking            Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedByUser     User?              @relation("VerifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([verificationStatus])
}

model BookingStatusLog {
  id              String        @id @default(cuid())
  bookingId       String
  oldStatus       BookingStatus?
  newStatus       BookingStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime      @default(now())

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedByUser   User?         @relation("ChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([newStatus])
}

model OpenTableSession {
  id               String                 @id @default(cuid())
  storeId          String
  tableId          String

  customerName     String
  customerPhone    String?
  notes            String?

  status           OpenTableSessionStatus @default(OPEN)

  openedAt         DateTime
  closedAt         DateTime?

  durationMinutes  Int?
  billedHours      Float?
  pricePerHour     Int                    @default(45000)
  totalPrice       Int?

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table            Table                  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([tableId, status])
}